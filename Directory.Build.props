<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!--
    A dependency, direct or transitive, with a known high (NU1903) or critical (NU1904) vulnerability fails the
    restore: on a developer machine, in CI and in the image build alike. Low and moderate ones stay warnings.
    Fix by updating the package, or by pinning the vulnerable transitive one in Directory.Packages.props.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Class libraries that host ASP.NET Core code get the same implicit usings as the Web SDK. -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Kadans.Modules.')) Or '$(MSBuildProjectName)' == 'Kadans.SharedKernel'">
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
