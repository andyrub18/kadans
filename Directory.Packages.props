<Project>

  <ItemGroup Label="Application">
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Humanizer" Version="3.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.15" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- Metrics to Prometheus and logs to Loki, both over OTLP (ARCHITECTURE → Observability). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup Label="Recurrence">
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup Label="Scheduling and push">
    <PackageVersion Include="Quartz" Version="3.20.0" />
    <PackageVersion Include="Quartz.Extensions.DependencyInjection" Version="3.20.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.20.0" />
    <PackageVersion Include="FirebaseAdmin" Version="3.6.0" />
    <!-- The 1.73 line, like the Google.Apis.Auth FirebaseAdmin 3.6 brings: one version of the shared Google libraries. -->
    <PackageVersion Include="Google.Apis.AndroidPublisher.v3" Version="1.73.0.4123" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.73.0" />
  </ItemGroup>

  <ItemGroup Label="Email">
    <PackageVersion Include="Resend" Version="0.15.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- An in-process host for middleware tests (rate limiting), no server or port needed. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <!-- MetricCollector: what a test recorded on a meter. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <!-- In-process integration tests on an in-memory database (Identity flows), no Postgres needed in CI. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Native SQLite under the provider: 2.1.11 and older ship a SQLite with GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="TUnit" Version="1.65.68" />
  </ItemGroup>

</Project>
