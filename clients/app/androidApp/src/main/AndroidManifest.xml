<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders ring on the phone (ARCHITECTURE): exact alarms ("Alarms & reminders", asked once, off by default
         since Android 14), set again after a reboot, and a twice-daily refresh that survives one. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Do Not Disturb during focus (ARCHITECTURE): a mode of Kadans' own, on while a focus phase counts down. The
         person gives "Do Not Disturb access" in the system's settings; it does not let an app read notifications. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- The phone's calendar beside the todos (ARCHITECTURE): read only, asked when the person turns it on in Settings
         or on the Calendar tab, never at start. The events are shown and go no further: not kept, not sent. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="true"
        android:name=".KadansApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kadans">
        <!-- configChanges: the screen is all Compose, which redraws itself for a new size, orientation or dark mode.
             Without this Android restarts the activity for each of them, and what was open (a form half filled in) was
             lost for Home: turning the phone was enough. -->
        <activity
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.Kadans.Starting"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The emailed password reset opens here rather than in the browser. Android checks the host's
                 /.well-known/assetlinks.json against the key this copy is signed with: only Google Play's copy qualifies. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api.kadansplanning.com" android:path="/auth/reset-password" />
            </intent-filter>
            <!-- Share to Kadans (docs/ARCHITECTURE.md → "Share to Kadans"): a text or a link shared from any app, or
                 selected in one, opens the form for a new todo filled in with it. Text only; nothing is saved before
                 the person presses "Create". The labels are what the share sheet and the selection menu show, in the
                 phone's language. -->
            <intent-filter android:label="@string/share_new_todo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_add_to_kadans">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Android's Do Not Disturb settings open the app that owns a mode from the mode's own page: Kadans opens
                 on its Settings, where the switch for "Do Not Disturb during focus" is. One mode, never more. -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
            </intent-filter>
            <meta-data
                android:name="android.service.zen.automatic.ruleType"
                android:value="@string/quiet_rule_type" />
            <meta-data
                android:name="android.service.zen.automatic.ruleInstanceLimit"
                android:value="1" />
        </activity>

        <service
            android:name="app.kadans.notifications.KadansMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kadans.default" />
        <!-- Pushes the system shows itself carry the app's mark and colour. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_kadans" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kadans_purple" />

        <!-- Not exported: only the system (alarms, boot, app update, permission granted) and this app reach them. -->
        <receiver
            android:name="app.kadans.reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <!-- A reminder's buttons: Start focus, Done, In 10 min (the app's own immutable PendingIntents). -->
        <receiver
            android:name="app.kadans.reminders.ReminderActionReceiver"
            android:exported="false" />
        <!-- A focus session's cycle done: "Another cycle", "Done" (the app's own immutable PendingIntents). -->
        <receiver
            android:name="app.kadans.pomodoro.PomodoroActionReceiver"
            android:exported="false" />
        <receiver
            android:name="app.kadans.reminders.ReminderRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name="app.kadans.reminders.ReminderSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Do Not Disturb during focus (docs/ARCHITECTURE.md → "Do Not Disturb during focus"). Not exported: only the
             system (its alarm, a restart, an app update, a permission granted, what the person did to Kadans' mode in
             the system's settings) and this app (the notice's "Sound on", an immutable PendingIntent) reach them. -->
        <receiver
            android:name="app.kadans.quiet.QuietAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="app.kadans.quiet.QuietActionReceiver"
            android:exported="false" />
        <receiver
            android:name="app.kadans.quiet.QuietSystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget (docs/ARCHITECTURE.md → "The home-screen widget"). A widget provider must be
             exported: the launcher, another app, talks to it. It acts on the system's widget actions only. -->
        <receiver
            android:name="app.kadans.widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <!-- A line's circle and its "Undo", and the alarm that sends a "Done" after its five seconds (the app's own
             immutable PendingIntents). -->
        <receiver
            android:name="app.kadans.widget.TodayWidgetActionReceiver"
            android:exported="false" />
        <!-- Not exported: the widget's own midnight alarm, and the system saying the clock or the time zone changed. -->
        <receiver
            android:name="app.kadans.widget.TodayWidgetClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name="app.kadans.widget.TodayWidgetRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
