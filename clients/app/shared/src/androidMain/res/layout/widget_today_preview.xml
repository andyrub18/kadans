<?xml version="1.0" encoding="utf-8"?>
<!-- What the system's widget picker shows (Android 12+): a day as the widget would show it, in the phone's language. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_kadans"
            android:tint="@color/widget_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_today"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_preview_date"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/widget_add" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPreviewLine">
        <ImageView style="@style/WidgetPreviewCheck" />
        <TextView style="@style/WidgetPreviewTime" android:text="09:00" />
        <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_first" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPreviewLine">
        <ImageView style="@style/WidgetPreviewCheck" />
        <TextView style="@style/WidgetPreviewTime" android:text="14:00" />
        <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_second" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPreviewLine">
        <ImageView style="@style/WidgetPreviewCheck" />
        <TextView style="@style/WidgetPreviewTime" android:text="18:30" />
        <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_third" />
    </LinearLayout>
</LinearLayout>
