<?xml version="1.0" encoding="utf-8"?>
<!-- One of today's todos: a circle that marks it done, then its hour and its title, which open it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="14dp">

    <ImageButton
        android:id="@+id/widget_line_check"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/widget_check_off" />

    <LinearLayout
        android:id="@+id/widget_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_line_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:minWidth="60dp"
            android:paddingEnd="12dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_line_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
