# Template for deploy/.env, which lives only on the server (git-ignored: it holds the secrets).
# Create it there with fresh random secrets instead of typing them (docs/DEPLOYMENT.md, step 2):
#   sed -e "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 32)/" \
#       -e "s/^JWT_KEY=.*/JWT_KEY=$(openssl rand -hex 32)/" \
#       -e "s/^GRAFANA_ADMIN_PASSWORD=.*/GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 24)/" .env.example > .env

# The public name of the API – what the apps talk to and what emailed links point at.
KADANS_DOMAIN=api.kadansplanning.com

# Letters and digits only (it is embedded in a connection string). Set once: changing it later does
# not change the password already stored in the database volume.
POSTGRES_PASSWORD=
# Signs every access token and encrypts the key ring behind emailed links. 32+ characters. Changing it
# signs everyone out and invalidates emailed links not yet opened.
JWT_KEY=

# Email – Resend, from an address on your verified domain.
EMAIL_PROVIDER=Resend
RESEND_API_KEY=
EMAIL_FROM=Kadans <no-reply@kadansplanning.com>

# Push – put the Firebase service-account file at deploy/secrets/firebase-admin.json.
# Use PUSH_PROVIDER=Log (and an empty JSON file `{}` there) to start without push.
PUSH_PROVIDER=Fcm

# Subscriptions (docs/DEPLOYMENT.md → Subscriptions). Leave BILLING_REQUIRED=false until the Play product is live:
# no paywall, every phone gets its reminders. Then put the Play Developer API key at deploy/secrets/play-developer-api.json.
BILLING_REQUIRED=false
PLAY_SERVICE_ACCOUNT_FILE=
# e.g. play-notifications@kadans-420a7.iam.gserviceaccount.com (the Pub/Sub push subscription's service account)
PLAY_NOTIFICATIONS_SERVICE_ACCOUNT=

# Google sign-in (docs/OWNER-CHECKLIST.md). Empty ids hide the button. The ids are public (the API
# publishes them at /auth/providers); the Desktop secret is not – it goes in .env only.
GOOGLE_DESKTOP_CLIENT_ID=63875242713-7jr3c15i9j35b9u44phglce6mavc1ip6.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=63875242713-28234bamcc1f577bgk0gqp2e32fevjfk.apps.googleusercontent.com

# First start only: creates the admin account. Set back to false afterwards and change the password.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Monitoring (docs/DEPLOYMENT.md → Monitoring). Grafana is reached through an SSH tunnel, user "admin"; alerts are
# emailed through Resend (RESEND_API_KEY above) from an address on the verified domain.
GRAFANA_ADMIN_PASSWORD=
ALERT_EMAIL=
ALERT_FROM_ADDRESS=alerts@kadansplanning.com
