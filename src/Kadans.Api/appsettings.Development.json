{
	"Serilog": {
		"Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning"
			}
		},
		"WriteTo": [
			{
				"Name": "Console"
			},
			{
				"Name": "File",
				"Args": {
					"path": "logs/log-.txt",
					"rollingInterval": "Day",
					"outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ThreadId}] [{MachineName}] {Message:lj}{NewLine}{Exception}"
				}
			}
		],
		"Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
	},
	"ConnectionStrings": {
		"kadans": "Host=localhost; Database=kadans; Username=postgres"
	},
	"Jwt": {
		"Key": "",
		"Issuer": "Kadans",
		"Audience": "Kadans.Clients",
		"ExpirationInMinutes": 60,
		"RefreshTokenExpirationInDays": 7
	},
	"InitialAdmin": {
		"Enabled": true,
		"Username": "admin",
		"Email": "admin@kadans.local",
		"Password": ""
	},
	"Email": {
		"Provider": "Log",
		"From": "Kadans <no-reply@kadans.local>",
		"LinkBaseUrl": "http://localhost:5199"
	},
	"ExternalAuth": {
		"Google": { "ClientIds": [], "Desktop": { "ClientId": "", "ClientSecret": "" }, "WebClientId": "" },
		"Apple": { "ClientIds": [] }
	},
	"Push": { "Provider": "Log" },
	"Billing": { "FakeStore": { "Enabled": true } },
	// The local monitoring stack (deploy/observability/compose.dev.yml); without it running, nothing is lost but the data.
	"Telemetry": {
		"MetricsEndpoint": "http://localhost:9090/api/v1/otlp/v1/metrics",
		"LogsEndpoint": "http://localhost:3100/otlp/v1/logs"
	},
	"RateLimiting": { "EmailPer15Minutes": 1000, "CredentialsPerMinute": 1000, "RequestsPerMinute": 100000 },
	"Identity": {
		"Lockout": {
			"MaxFailedAccessAttempts": 5,
			"DefaultLockoutMinutes": 15,
			"AllowedForNewUsers": true
		}
	}
}
