# Settings for a load-test run started by pushing the loadtest-run branch (.github/workflows/loadtest.yml).
# Totals over all shards. STAGES (duration:percent of the users) replaces RAMP/HOLD when set.
SESSION_TAG=run5
APP_VUS=2000
LIVE_VUS=3000
RAMP=5m
HOLD=15m
STAGES=3m:25,4m:25,3m:50,4m:50,3m:75,4m:75,3m:100,5m:100
